# Chrome Web Store Automated Publish Credentials
# 1. Extension ID (From Chrome Web Store Developer Dashboard URL)
CWS_EXTENSION_ID=

# 2. Google Cloud OAuth 2.0 Client ID & Secret
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# 3. OAuth 2.0 Refresh Token (Generate with: python3 scripts/cws_auth.py)
CWS_REFRESH_TOKEN=
